# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Upstream clones (public: abcboy101/poke-corpus, pret/pokefirered) and built decks.
vendor/
*.apkg

# data/: only the LLM answers are tracked, since they are the expensive part to
# regenerate. Stage outputs, reports, logs and the dry-run caches are rebuilt
# in about a minute with no LLM calls.
# Keep this repo private: the caches hold Nintendo's game text.
data/*
!data/cache/
data/cache/*
!data/cache/classify/
!data/cache/sense_merge/
!data/cache/analyse/
data/cache/analyse/*
!data/cache/analyse/main/
